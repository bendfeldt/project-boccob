# Dagster code location image: ingestion (dlt) + transform (dbt project) + orchestration + governance tooling.
# Build with scripts/build-image.sh (podman). Base images are pinned by digest; override the ARGs
# with the mirrored references in the internal registry for air-gapped builds.
ARG PYTHON_IMAGE=docker.io/library/python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32@sha256:0d127b3a7049b879a6e18a79c7f33fea59aa83c226464248f89cfb716a6b96f5

FROM ${UV_IMAGE} AS uv

# ---- build stage: resolve the locked dependency set into /opt/venv -------------------------
FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_NO_CACHE=1
# Package index: public PyPI by default, an internal mirror in air-gapped environments.
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
WORKDIR /src

# dependencies first (cached layer); an optional CA bundle secret supports TLS-inspecting proxies / internal CAs
COPY pyproject.toml uv.lock ./
RUN --mount=type=secret,id=ca_bundle,required=false \
    if [ -s /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle; fi; \
    uv sync --frozen --no-dev --no-install-project

COPY lakehouse ./lakehouse
COPY ingestion ./ingestion
COPY governance ./governance
COPY orchestration ./orchestration
RUN --mount=type=secret,id=ca_bundle,required=false \
    if [ -s /run/secrets/ca_bundle ]; then export SSL_CERT_FILE=/run/secrets/ca_bundle; fi; \
    uv sync --frozen --no-dev --no-editable

# dbt project + pre-built manifest (the code location loads it without touching Trino)
COPY transform /app/transform
RUN cd /app/transform \
    && TRINO_HOST=build-time TRINO_USER=build-time DBT_PROFILES_DIR=/app/transform \
       /opt/venv/bin/dbt parse --no-send-anonymous-usage-stats --quiet \
    && rm -rf /app/transform/logs \
    && test -s /app/transform/target/manifest.json

# ---- runtime stage ---------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS runtime
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="boccob-dagster-code-location" \
      org.opencontainers.image.description="Boccob lakehouse solution: Dagster code location with dlt ingestion, dbt project and governance tooling" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN groupadd --gid 10001 lakehouse \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin lakehouse

COPY --from=build /opt/venv /opt/venv
COPY --from=build /app /app

# Everything writable lives under /tmp so the container runs with a read-only root filesystem
# (mount an emptyDir on /tmp). DAGSTER_HOME defaults to /tmp and is normally overridden by the
# Dagster deployment (instance configuration).
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    DAGSTER_HOME=/tmp \
    DBT_PROJECT_DIR=/app/transform \
    DBT_PROFILES_DIR=/app/transform \
    DBT_TARGET_PATH=/tmp/dbt-target \
    DBT_LOG_PATH=/tmp/dbt-logs \
    DLT_DATA_DIR=/tmp/dlt \
    DLT_PIPELINES_DIR=/tmp/dlt/pipelines \
    DO_NOT_TRACK=1 \
    LAKEHOUSE_VERSION=${VERSION}

USER 10001:10001
WORKDIR /app
EXPOSE 4000
# gRPC code server; the Dagster Helm chart may override the command (dagster api grpc ... -m orchestration.definitions)
CMD ["dagster", "api", "grpc", "--host", "0.0.0.0", "--port", "4000", "--module-name", "orchestration.definitions"]
